# Google Sheets ID (Brauzer manzilidan olingan)
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Service Account JSON mazmuni (Bitta qatorga joylashtirilgan bo'lishi kerak)
GOOGLE_SHEETS_CREDENTIALS='{"type": "service_account", "project_id": "...", ...}'

# JWT signing key (kamida 32 ta belgi tavsiya etiladi)
JWT_SECRET=change_me_to_a_long_random_secret
